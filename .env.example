# BluePeak AI Desk: LOCAL DEVELOPMENT template.
#
# Copy to .env and fill in your own values. Never commit .env.
# Names must match the fields in app/core/config.py; unknown names are
# silently ignored, and an empty value is invalid for numbers and flags.
#
# Every uncommented line below is valid as written and keeps the application
# in read-only mode: paid AI routes answer 503, access codes, quotas,
# sessions, streaming, voice, transcription, admin ingestion and the API docs
# are all off. These development defaults are NOT production-safe settings:
# production needs every value in the "Production" notes, checked on the
# platform (see the deployment checks before enabling anything).
#
# Lines starting with "#" are documentation only. Secrets are left empty:
# never put a real key, secret, code or token in this file.

APP_ENV=development
# Production: APP_ENV=production (https origins and Secure cookies are then
# enforced, and access codes refuse to start without a client-IP source).

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Providers. Secrets: leave empty here, set them only in .env or the platform.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
PINECONE_INDEX_NAME=enterprise-it-rag-assistant
PINECONE_NAMESPACE=company-it-kb
TOP_K=4
MAX_RETRIES=2

# Optional external-call limits, unset by default (leave commented out).
# Longest wait honored for one Pinecone Retry-After header (0-21600 s):
# PINECONE_RETRY_AFTER_MAX_SECONDS=5
# Cooperative deadline for a stateless /api/chat question (> 0, <= 3600 s):
# CHAT_DEADLINE_SECONDS=90

# ---------------------------------------------------------------------------
# Browser origins (S1-5). Exact scheme://host[:port] values, comma-separated.
# Empty: paid routes stay off and browser requests to /api/access are refused.
# ---------------------------------------------------------------------------
PUBLIC_ORIGINS=
# Production (https only), every origin a browser uses:
# PUBLIC_ORIGINS=https://your-app.ondigitalocean.app,https://desk.example.com
# Local development over plain HTTP:
# PUBLIC_ORIGINS=http://localhost:8080

# ---------------------------------------------------------------------------
# Access codes (S1-3, S1-5). Off. Paid AI routes require access AND quotas.
# ---------------------------------------------------------------------------
ACCESS_ENABLED=false
# Code digests only, never the codes (python -m app.services.access new-code <id>):
# ACCESS_CODE_HASHES=<id>:<sha256 digest>[:YYYY-MM-DD]
# Cookie signing secret, 43+ random characters (python -m app.services.access new-secret):
# ACCESS_COOKIE_SECRET=
# Previous secrets, comma-separated, only while rotating:
# ACCESS_COOKIE_PREVIOUS_SECRETS=
# ACCESS_COOKIE_SECURE=true
# (false only with APP_ENV=development over plain HTTP)
#
# Client identity for the failed-attempt throttles. Production requires
# exactly ONE of these, or access refuses to start (fails closed):
# ACCESS_CLIENT_IP_HEADER=do-connecting-ip
#   Only after verifying on the platform that the edge sets it on every
#   request and overwrites any value a client sends (unverified today).
# ACCESS_TRUST_SOCKET_PEER=false
#   Never true behind a shared proxy such as DigitalOcean App Platform:
#   every visitor would share one address, and a few wrong codes would
#   lock everyone out.

# ---------------------------------------------------------------------------
# Quotas (S1-4). Off. Production with access requires them.
# ---------------------------------------------------------------------------
QUOTA_ENABLED=false
# Enabling quotas also requires bounded deadlines (the app refuses to start
# otherwise), for example:
# CHAT_DEADLINE_SECONDS=90
# STREAM_TIMEOUT_SECONDS=90
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=1
# SESSION_TURN_MAX_SECONDS=105
# PINECONE_RETRY_AFTER_MAX_SECONDS=5
#
# Quotas, failed-attempt throttles and the admin ingest slot are kept in
# memory, PER PROCESS. Run exactly one worker (the Dockerfile pins it) and
# one instance (check the platform: one worker does not mean one instance).
# They also reset whenever the process restarts or the app is redeployed:
# counters start again from zero (a deploy is a fresh daily quota).
# Sessions and their caps live in a local SQLite file instead: PER INSTANCE,
# and kept across restarts only if that file's storage persists.
#
# Deployment: set NO UVICORN_* and NO WEB_CONCURRENCY environment variables.
# uvicorn reads them for any option the command line does not pin (for
# example reload, root path, socket or concurrency limits); the Dockerfile
# command pins the worker count, proxy headers and the lifespan only.

# ---------------------------------------------------------------------------
# Optional features. All off.
# ---------------------------------------------------------------------------
STREAM_ENABLED=false
SESSIONS_ENABLED=false
# SESSION_MAX_ACTIVE_PER_OWNER=20

# Opt-in "Read answers aloud" (browser speech, on-device voices only).
VOICE_ENABLED=false

# Speech-to-text (POST /api/voice/transcribe, OpenAI, paid), separate from
# VOICE_ENABLED. It requires an access code and a quota like chat, and it is
# refused in production until it is verified there.
VOICE_TRANSCRIPTION_ENABLED=false
# VOICE_TRANSCRIPTION_MODEL=whisper-1
# Per OpenAI attempt (1-120 s); retries 0-2 (quotas require 0):
# VOICE_TRANSCRIPTION_TIMEOUT_SECONDS=30
# VOICE_TRANSCRIPTION_MAX_RETRIES=0

# ---------------------------------------------------------------------------
# Admin ingestion (POST /api/ingest, X-Admin-Key header). Secret.
# Empty or shorter than 32 characters: ingestion stays off (503).
# ---------------------------------------------------------------------------
ADMIN_API_KEY=
# Failed-attempt throttle (per client and in total, per window):
# ADMIN_MAX_FAILED_ATTEMPTS=10
# ADMIN_FAILURE_WINDOW_SECONDS=900
# ADMIN_MAX_GLOBAL_FAILED_ATTEMPTS=100

# ---------------------------------------------------------------------------
# API docs (/docs, /redoc, /openapi.json). Local development only.
# ---------------------------------------------------------------------------
API_DOCS_ENABLED=false
