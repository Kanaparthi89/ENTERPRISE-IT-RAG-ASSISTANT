# Copy to .env and add your own credentials.
# Variable names must match the fields in app/core/config.py; unknown names
# are silently ignored.

# LLM and embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector store
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-it-rag-assistant
PINECONE_NAMESPACE=company-it-kb

# External web search
TAVILY_API_KEY=

# Required for POST /api/ingest (sent as the X-Admin-Key header)
ADMIN_API_KEY=

# Optional tuning
TOP_K=4
MAX_RETRIES=2
LOG_LEVEL=INFO
