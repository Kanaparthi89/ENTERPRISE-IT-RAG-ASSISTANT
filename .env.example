# Copy to .env and add your own credentials.
# Variable names must match the fields in app/core/config.py; unknown names
# are silently ignored.

# LLM and embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector store
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-it-rag-assistant
PINECONE_NAMESPACE=company-it-kb

# External web search
TAVILY_API_KEY=

# Required for POST /api/ingest (sent as the X-Admin-Key header)
ADMIN_API_KEY=

# Optional tuning
TOP_K=4
MAX_RETRIES=2
LOG_LEVEL=INFO

# Optional external-call limits (H1-5), unset by default. Leave them
# commented out to keep the default behavior; an empty value is invalid.
# Longest wait honored for one Pinecone Retry-After header (0-21600 s):
# PINECONE_RETRY_AFTER_MAX_SECONDS=30
# Cooperative deadline for a stateless /api/chat question (> 0, <= 3600 s):
# CHAT_DEADLINE_SECONDS=120
